{
    "info": {
        "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
        "name": "JSONPlaceholder REST API - Functional Test Suite",
        "description": "Functional API test suite for JSONPlaceholder REST endpoints (https://jsonplaceholder.typicode.com).\nCovers GET, POST, PUT, PATCH, and DELETE requests with automated checks for status codes, response times, headers, schemas, and field values.\n\nPrepared for: QA Internship Program\nPrepared by: Azhan Shoaib",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "01_GET_Requests",
            "description": "Functional validation of GET endpoints for retrieving resources and filtering data.",
            "item": [
                {
                    "name": "GET - Retrieve All Posts",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Make sure the response time is fast (under 2500ms)",
                                    "pm.test(\"Response time is acceptable (< 2500ms)\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                                    "});",
                                    "",
                                    "// 3. Verify that the response header Content-Type is JSON",
                                    "pm.test(\"Content-Type header is application/json\", function () {",
                                    "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                                    "});",
                                    "",
                                    "// 4. Check that the response is an array containing all 100 posts",
                                    "pm.test(\"Response is an array with 100 posts\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an(\"array\");",
                                    "    pm.expect(jsonData.length).to.eql(100);",
                                    "});",
                                    "",
                                    "// 5. Verify that each post has id, userId, title, and body fields",
                                    "pm.test(\"Each post contains required fields with valid data types\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    const samplePost = jsonData[0];",
                                    "    ",
                                    "    pm.expect(samplePost).to.have.property(\"userId\");",
                                    "    pm.expect(samplePost).to.have.property(\"id\");",
                                    "    pm.expect(samplePost).to.have.property(\"title\");",
                                    "    pm.expect(samplePost).to.have.property(\"body\");",
                                    "    ",
                                    "    pm.expect(samplePost.userId).to.be.a(\"number\");",
                                    "    pm.expect(samplePost.id).to.be.a(\"number\");",
                                    "    pm.expect(samplePost.title).to.be.a(\"string\");",
                                    "    pm.expect(samplePost.body).to.be.a(\"string\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts"
                            ]
                        },
                        "description": "Fetches all posts from the API and verifies list structure, array size, item schemas, and response time."
                    },
                    "response": []
                },
                {
                    "name": "GET - Retrieve Single Post by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Make sure the response time is fast (under 2500ms)",
                                    "pm.test(\"Response time is acceptable (< 2500ms)\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                                    "});",
                                    "",
                                    "// 3. Verify that the response header Content-Type is JSON",
                                    "pm.test(\"Response header Content-Type is JSON\", function () {",
                                    "    pm.response.to.have.header(\"Content-Type\");",
                                    "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                                    "});",
                                    "",
                                    "// 4. Confirm the returned post ID matches what we requested (ID 1)",
                                    "pm.test(\"Verify exact post ID matches requested ID\", function () {",
                                    "    const post = pm.response.json();",
                                    "    const expectedId = parseInt(pm.environment.get(\"samplePostId\") || \"1\", 10);",
                                    "    pm.expect(post.id).to.eql(expectedId);",
                                    "});",
                                    "",
                                    "// 5. Confirm userId, title, and body are present and not empty",
                                    "pm.test(\"Verify userId, title, and body are valid and non-empty\", function () {",
                                    "    const post = pm.response.json();",
                                    "    pm.expect(post.userId).to.be.a(\"number\").and.to.be.above(0);",
                                    "    pm.expect(post.title).to.be.a(\"string\").and.to.have.lengthOf.above(0);",
                                    "    pm.expect(post.body).to.be.a(\"string\").and.to.have.lengthOf.above(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{samplePostId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{samplePostId}}"
                            ]
                        },
                        "description": "Retrieves post with ID 1 and validates specific field names, data types, and values."
                    },
                    "response": []
                },
                {
                    "name": "GET - Retrieve Comments for Post",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Confirm comments come back as an array with valid fields",
                                    "pm.test(\"Response is an array with valid comment objects\", function () {",
                                    "    const comments = pm.response.json();",
                                    "    pm.expect(comments).to.be.an(\"array\");",
                                    "    pm.expect(comments.length).to.be.above(0);",
                                    "    ",
                                    "    const firstComment = comments[0];",
                                    "    pm.expect(firstComment).to.have.property(\"postId\");",
                                    "    pm.expect(firstComment).to.have.property(\"id\");",
                                    "    pm.expect(firstComment).to.have.property(\"name\");",
                                    "    pm.expect(firstComment).to.have.property(\"email\");",
                                    "    pm.expect(firstComment).to.have.property(\"body\");",
                                    "});",
                                    "",
                                    "// 3. Verify that the email format inside comments is valid",
                                    "pm.test(\"Validate email format in comments\", function () {",
                                    "    const comments = pm.response.json();",
                                    "    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
                                    "    pm.expect(emailRegex.test(comments[0].email)).to.be.true;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{samplePostId}}/comments",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{samplePostId}}",
                                "comments"
                            ]
                        },
                        "description": "Validates nested resource retrieval for comments belonging to a specific post."
                    },
                    "response": []
                },
                {
                    "name": "GET - Filter Posts by User ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Check that every returned post has userId equal to 1",
                                    "pm.test(\"All returned posts belong to requested userId\", function () {",
                                    "    const posts = pm.response.json();",
                                    "    const expectedUserId = parseInt(pm.environment.get(\"sampleUserId\") || \"1\", 10);",
                                    "    pm.expect(posts).to.be.an(\"array\");",
                                    "    pm.expect(posts.length).to.be.above(0);",
                                    "    ",
                                    "    posts.forEach(function (post) {",
                                    "        pm.expect(post.userId).to.eql(expectedUserId);",
                                    "    });",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts?userId={{sampleUserId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "{{sampleUserId}}"
                                }
                            ]
                        },
                        "description": "Validates query parameter filtering by retrieving posts created by a specific user."
                    },
                    "response": []
                },
                {
                    "name": "GET - Retrieve Non-Existent Post (Negative Test)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the API returns 404 Not Found for non-existent ID",
                                    "pm.test(\"Status code is 404 Not Found\", function () {",
                                    "    pm.response.to.have.status(404);",
                                    "});",
                                    "",
                                    "// 2. Verify that the response body is an empty object",
                                    "pm.test(\"Response body is an empty object\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an(\"object\");",
                                    "    pm.expect(Object.keys(jsonData).length).to.eql(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{nonExistentPostId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{nonExistentPostId}}"
                            ]
                        },
                        "description": "Negative testing scenario to verify appropriate HTTP 404 Not Found error handling when resource does not exist."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "02_POST_Requests",
            "description": "Functional validation of POST endpoints for resource creation.",
            "item": [
                {
                    "name": "POST - Create New Post",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 201 Created",
                                    "pm.test(\"Status code is 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "// 2. Make sure the response time is fast (under 2500ms)",
                                    "pm.test(\"Response time is acceptable (< 2500ms)\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                                    "});",
                                    "",
                                    "// 3. Verify that the server generated id 101 and echoed back our submitted data",
                                    "pm.test(\"Response contains generated ID and echoed payload data\", function () {",
                                    "    const responseData = pm.response.json();",
                                    "    ",
                                    "    pm.expect(responseData).to.have.property(\"id\");",
                                    "    pm.expect(responseData.id).to.be.a(\"number\");",
                                    "    pm.expect(responseData.id).to.eql(101);",
                                    "    ",
                                    "    pm.expect(responseData.title).to.eql(\"Automated API Testing with Postman\");",
                                    "    pm.expect(responseData.body).to.eql(\"Validating REST endpoints, headers, status codes, and JSON schemas.\");",
                                    "    pm.expect(responseData.userId).to.eql(1);",
                                    "    ",
                                    "    // Save the created ID to environment for chaining",
                                    "    pm.environment.set(\"createdPostId\", responseData.id);",
                                    "});",
                                    "",
                                    "// 4. Verify Content-Type header is JSON",
                                    "pm.test(\"Response Content-Type header contains application/json\", function () {",
                                    "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json; charset=UTF-8",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Automated API Testing with Postman\",\n    \"body\": \"Validating REST endpoints, headers, status codes, and JSON schemas.\",\n    \"userId\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/posts",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts"
                            ]
                        },
                        "description": "Creates a new post record and verifies HTTP 201 Created status, generated ID, and payload integrity."
                    },
                    "response": []
                },
                {
                    "name": "POST - Create Post with Custom Dynamic Payload",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Generate a unique timestamp so each test run has dynamic title and body",
                                    "const randomStamp = Date.now();",
                                    "pm.variables.set(\"dynamicTitle\", \"Performance Test Post - \" + randomStamp);",
                                    "pm.variables.set(\"dynamicBody\", \"Detailed stress test content generated at timestamp \" + randomStamp);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 201 Created",
                                    "pm.test(\"Status code is 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "// 2. Confirm that the dynamic title and body were echoed back correctly",
                                    "pm.test(\"Dynamic post fields match submitted values\", function () {",
                                    "    const responseData = pm.response.json();",
                                    "    pm.expect(responseData.title).to.eql(pm.variables.get(\"dynamicTitle\"));",
                                    "    pm.expect(responseData.body).to.eql(pm.variables.get(\"dynamicBody\"));",
                                    "    pm.expect(responseData.userId).to.eql(1);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json; charset=UTF-8",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"{{dynamicTitle}}\",\n    \"body\": \"{{dynamicBody}}\",\n    \"userId\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/posts",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts"
                            ]
                        },
                        "description": "Demonstrates pre-request script usage to dynamically inject timestamps and verify response payload consistency."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "03_PUT_Requests",
            "description": "Functional validation of PUT endpoints for updating complete resource representations.",
            "item": [
                {
                    "name": "PUT - Update Post by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Make sure the response time is fast (under 2500ms)",
                                    "pm.test(\"Response time is acceptable (< 2500ms)\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                                    "});",
                                    "",
                                    "// 3. Confirm that the response reflects the updated title and body while preserving ID 1",
                                    "pm.test(\"Response contains updated title, body, and consistent ID\", function () {",
                                    "    const data = pm.response.json();",
                                    "    ",
                                    "    pm.expect(data.id).to.eql(1);",
                                    "    pm.expect(data.title).to.eql(\"Updated Post Title - QA Regression Suite\");",
                                    "    pm.expect(data.body).to.eql(\"This post content has been modified during automated test execution.\");",
                                    "    pm.expect(data.userId).to.eql(1);",
                                    "});",
                                    "",
                                    "// 4. Verify Content-Type header is JSON",
                                    "pm.test(\"Response has correct Content-Type header\", function () {",
                                    "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json; charset=UTF-8",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 1,\n    \"title\": \"Updated Post Title - QA Regression Suite\",\n    \"body\": \"This post content has been modified during automated test execution.\",\n    \"userId\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{samplePostId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{samplePostId}}"
                            ]
                        },
                        "description": "Performs a full resource update on Post 1 and validates returned entity values."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "04_PATCH_Requests",
            "description": "Functional validation of PATCH endpoints for partial updates.",
            "item": [
                {
                    "name": "PATCH - Partial Update Post Title",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK",
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// 2. Confirm that only the title was updated while preserving other fields",
                                    "pm.test(\"Title is updated while other fields remain preserved\", function () {",
                                    "    const data = pm.response.json();",
                                    "    pm.expect(data.id).to.eql(1);",
                                    "    pm.expect(data.title).to.eql(\"Patched Title via QA Automation\");",
                                    "    pm.expect(data.userId).to.be.a(\"number\");",
                                    "    pm.expect(data.body).to.be.a(\"string\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json; charset=UTF-8",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Patched Title via QA Automation\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{samplePostId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{samplePostId}}"
                            ]
                        },
                        "description": "Validates partial resource update by altering only the title field."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "05_DELETE_Requests",
            "description": "Functional validation of DELETE endpoints for resource removal.",
            "item": [
                {
                    "name": "DELETE - Delete Post by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// 1. Check that the status code is 200 OK or 204 No Content",
                                    "pm.test(\"Status code is 200 OK or 204 No Content\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                                    "});",
                                    "",
                                    "// 2. Make sure the response time is fast (under 2500ms)",
                                    "pm.test(\"Response time is acceptable (< 2500ms)\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                                    "});",
                                    "",
                                    "// 3. Confirm that the response body is an empty JSON object",
                                    "pm.test(\"Response body is an empty JSON object\", function () {",
                                    "    const data = pm.response.json();",
                                    "    pm.expect(data).to.be.an(\"object\");",
                                    "    pm.expect(Object.keys(data).length).to.eql(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/posts/{{samplePostId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "posts",
                                "{{samplePostId}}"
                            ]
                        },
                        "description": "Deletes the post resource with ID 1 and validates successful deletion response."
                    },
                    "response": []
                }
            ]
        }
    ],
